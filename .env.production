# ============================================================
# PRODUCTION ENVIRONMENT — Hostinger Deployment
# ============================================================
# Salin file ini ke .env dan isi nilai yang sesuai.
# JANGAN commit .env ke repository.

# Port server API.
PORT=3000

# Set true bila aplikasi berjalan di belakang reverse proxy
# (nginx, Apache mod_proxy, Cloudflare) agar rate limiter membaca IP klien yang benar.
TRUST_PROXY=true

# WAJIB. Buat secret baru untuk produksi:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=2=$<IFY%JIgBt_.U.d5)(cd[D:X(O{:YQl0<Q;+M$U54a|%jT-6Ko$3yK5#kphSGG2OMK,|qdDQss%ae${XZof

# Secret terpisah untuk refresh token (opsional, akan diturunkan dari JWT_SECRET bila kosong).
JWT_REFRESH_SECRET=

# Durasi sesi
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_REMEMBER_DAYS=30

# Origin frontend yang diizinkan mengakses API.
# Backend di api.mahreenindonesia.com, frontend di mahreenindonesia.com.
CORS_ORIGIN=https://mahreenindonesia.com, https://www.mahreenindonesia.com

# Koneksi MySQL — isi dari Hostinger hPanel > Databases > MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u436386775_mahreen
DB_PASS=MahreenIndonesiaSVA1
DB_NAME=u436386775_mahreen_db

# Frontend route links untuk default newsroom settings.
FRONTEND_CTA_PRIMARY_LINK=/tanya-mahreen
FRONTEND_CTA_SECONDARY_LINK=/contact

# Midtrans Payment Gateway (isi untuk produksi).
# MIDTRANS_SERVER_KEY=Mid-server-XXXXX
# MIDTRANS_CLIENT_KEY=Mid-client-XXXXX
# MIDTRANS_IS_PRODUCTION=true

# Origin frontend untuk callback URL setelah pembayaran.
FRONTEND_ORIGIN=https://mahreenindonesia.com

NODE_ENV=production
